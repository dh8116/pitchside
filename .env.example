# ── Model: set at least ONE (several = automatic fallback, in this order) ──
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free: https://console.groq.com/keys
GROQ_API_KEY=
# Paid, best quality, enables web-search competitor checks
ANTHROPIC_API_KEY=
# Any other OpenAI-compatible endpoint (OpenRouter, a local Ollama, ...)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# LLM_PROVIDERS=gemini,groq   # optional: choose/override the order
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b

# ── Channels ────────────────────────────────────────────────────────────────

# Public HTTPS address of this server (used for webhook URLs and Twilio signature checks)
PUBLIC_URL=https://pitchside.example.com

# Shared secret appended as ?secret=… to the iMessage and email webhook URLs
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── WhatsApp (Meta WhatsApp Cloud API) ──────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── SMS and/or WhatsApp via Twilio ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=whatsapp:+15551234567

# ── iMessage via a BlueBubbles server on a Mac ─────────────────────────────
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=

# ── Email via Postmark ─────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=Pitchside <coach@yourdomain.com>

# ── Optional ───────────────────────────────────────────────────────────────
# PITCHSIDE_MODEL=claude-opus-5   # when using Claude
# PITCHSIDE_WEB_SEARCH=1      # 0 turns off competitor/web lookups
# CHECKINS=1                  # 0 turns off morning check-ins
# CHECKIN_HOUR=8              # local hour (per person) for the check-in
# DEFAULT_TIMEZONE=UTC        # people can change theirs by texting "timezone Europe/London"
# WEB_CHAT=1                  # 0 disables the browser test chat (do this on a public server)
# PORT=3000
# DATA_DIR=./data
