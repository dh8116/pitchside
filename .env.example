# ── Model: set at least ONE (several = automatic fallback, in this order) ──
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free: https://console.groq.com/keys
GROQ_API_KEY=
# Paid, best quality, enables web-search competitor checks
ANTHROPIC_API_KEY=
# Any other OpenAI-compatible endpoint (OpenRouter, a local Ollama, ...)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# LLM_PROVIDERS=gemini,groq   # optional: choose/override the order
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b

# ── Channels ────────────────────────────────────────────────────────────────

# Public HTTPS address of this server (used for webhook URLs and Twilio signature checks)
PUBLIC_URL=https://pitchside.example.com

# Shared secret appended as ?secret=… to the iMessage and email webhook URLs
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── WhatsApp (Meta WhatsApp Cloud API) ──────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── SMS and/or WhatsApp via Twilio ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=whatsapp:+15551234567

# ── iMessage via a BlueBubbles server on a Mac ─────────────────────────────
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=

# ── Email via Postmark ─────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=Pitchside <coach@yourdomain.com>

# ── Auto-posting (optional) ────────────────────────────────────────────────
# Who may publish: comma-separated keys or addresses, e.g.
#   +15551234567, jo@startup.io, whatsapp:+15551234567, web (the local browser chat)
# Nobody else can post, even if they ask.
POST_OWNERS=
# 1 = publish drafts the moment they're written. Default: wait for the owner to reply "post it".
# AUTO_POST=1
# X: developer.x.com → app with Read and Write → Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# LinkedIn: OAuth token with w_member_social; author is urn:li:person:… or urn:li:organization:…
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR=
# LINKEDIN_VERSION=202510
# Bluesky: bsky.app → Settings → Privacy and security → App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social

# ── Optional ───────────────────────────────────────────────────────────────
# PITCHSIDE_MODEL=claude-opus-5   # when using Claude
# PITCHSIDE_WEB_SEARCH=1      # 0 turns off competitor/web lookups
# CHECKINS=1                  # 0 turns off morning check-ins
# CHECKIN_HOUR=8              # local hour (per person) for the check-in
# DEFAULT_TIMEZONE=UTC        # people can change theirs by texting "timezone Europe/London"
# Browser chat at your server's address. On a public server, protect it with a passcode:
WEB_CHAT_PASSWORD=
# WEB_CHAT=1                  # 0 turns the browser chat off entirely
# PORT=3000
# DATA_DIR=./data
